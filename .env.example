# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# The framework's checkout the docs are read from (default: ../amxts when it
# exists, github.com/amxts/amxts otherwise)
AMXTS_CORE_PATH=
# The modules catalog's checkout, whose modules.json the catalog lists
# (default: ../amxts-registry when it exists, github.com/amxts/modules otherwise)
AMXTS_REGISTRY_PATH=
# The folder with the modules' checkouts, one folder per repository, named as
# it is (default: ../amxts-modules when it exists, each module's GitHub
# repository otherwise)
AMXTS_MODULES_PATH=
